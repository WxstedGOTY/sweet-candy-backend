# ---------------------------------------------------------------
# Copy this file to ".env" and fill in real values.
# NEVER commit the real ".env" file to git or share it publicly.
# ---------------------------------------------------------------

# Server
PORT=3000
NODE_ENV=production
# Public base URL of this backend once deployed (no trailing slash)
PUBLIC_BASE_URL=https://your-backend-domain.example.com
# URL of your storefront (for Stripe success/cancel redirects and CORS)
STOREFRONT_URL=https://your-storefront-domain.example.com

# Security
# Long random string used to sign admin/courier login sessions (JWT).
# Generate one with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace_with_a_long_random_value

# Stripe (https://dashboard.stripe.com/apikeys)
STRIPE_SECRET_KEY=sk_live_or_sk_test_xxx
# From https://dashboard.stripe.com/webhooks after creating the webhook endpoint
STRIPE_WEBHOOK_SECRET=whsec_xxx

# Google Maps Distance Matrix API (https://console.cloud.google.com/)
# Must have "Distance Matrix API" and "Geocoding API" enabled, billing active,
# and should be restricted by API key referrer/IP restrictions in production.
GOOGLE_MAPS_API_KEY=your_google_maps_api_key

# Store location (used as the delivery-distance origin)
STORE_ADDRESS="Posidonos 25, Rio, Patra 265 00, Greece"

# Delivery rules
MIN_ORDER_EUR=10
DELIVERY_FEE_EUR=1
FREE_DELIVERY_THRESHOLD_EUR=25
MAX_DELIVERY_DISTANCE_METERS=20000
